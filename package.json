{
  "name": "repo1-playwright-e2e",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E test framework for a demo e-commerce site, with accessibility checks and GitHub Actions CI.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:all": "cross-env ALL_BROWSERS=1 playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:a11y": "playwright test --grep @a11y",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "allure:generate": "npx -y allure-commandline generate allure-results --clean -o allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure-playwright": "^3.15.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
